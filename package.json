{
  "name": "convertkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "native:helpers": "sh scripts/build-native-helpers.sh",
    "dev": "vite",
    "build": "tsgo -config tsconfig.json && vite build",
    "check": "tsgo -config tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json src/",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "oxfmt -c .oxfmtrc.json --write src/",
    "icons:generate": "sh scripts/generate-icons.sh",
    "release:check": "sh scripts/release-macos.sh --check",
    "release:doctor": "sh scripts/release-macos.sh --doctor",
    "package:smoke:apple-silicon": "sh scripts/check-apple-silicon-package.sh",
    "release:macos": "pnpm package:smoke:apple-silicon && sh scripts/release-macos.sh release",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inclusive-sans": "^5.3.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@rslint/tsgo": "^0.3.1",
    "@tailwindcss/vite": "^4.1.3",
    "@tauri-apps/cli": "^2.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
