{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ConvertKit",
  "version": "0.1.0",
  "identifier": "com.dropforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ConvertKit",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "tiff", "tif", "bmp", "gif", "ico", "avif", "heic", "heif"],
        "name": "Image",
        "mimeType": "image/*",
        "role": "Viewer"
      },
      {
        "ext": ["mp4", "m4v", "mov", "webm", "mkv", "avi"],
        "name": "Video",
        "mimeType": "video/*",
        "role": "Viewer"
      },
      {
        "ext": ["mp3", "wav", "aac", "flac", "ogg", "oga", "m4a"],
        "name": "Audio",
        "mimeType": "audio/*",
        "role": "Viewer"
      },
      {
        "ext": ["pdf", "docx", "html", "htm", "md", "markdown", "epub", "txt"],
        "name": "Document",
        "role": "Viewer"
      },
      {
        "ext": ["svg"],
        "name": "SVG Vector",
        "mimeType": "image/svg+xml",
        "role": "Viewer"
      }
    ]
  }
}
