{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ConvertKit",
  "version": "0.1.0",
  "identifier": "com.dropforge.convertkit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm native:helpers && pnpm dev",
    "beforeBuildCommand": "pnpm native:helpers && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ConvertKit",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/convertkit-vision-ocr",
      "binaries/convertkit-image-pdf",
      "binaries/whisper-cli"
    ],
    "resources": {
      "runtime/whisper/": "whisper-runtime/"
    },
    "icon": ["icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "tiff", "tif", "bmp", "gif", "ico", "avif", "heic", "heif"],
        "name": "Image",
        "mimeType": "image/*",
        "role": "Viewer"
      },
      {
        "ext": ["mp4", "m4v", "mov", "webm", "mkv", "avi"],
        "name": "Video",
        "mimeType": "video/*",
        "role": "Viewer"
      },
      {
        "ext": ["mp3", "wav", "aac", "flac", "ogg", "oga", "m4a"],
        "name": "Audio",
        "mimeType": "audio/*",
        "role": "Viewer"
      },
      {
        "ext": ["pdf", "docx", "html", "htm", "md", "markdown", "epub", "txt"],
        "name": "Document",
        "role": "Viewer"
      },
      {
        "ext": ["svg"],
        "name": "SVG Vector",
        "mimeType": "image/svg+xml",
        "role": "Viewer"
      },
      {
        "ext": ["zip"],
        "contentTypes": ["public.zip-archive"],
        "name": "ZIP Archive",
        "mimeType": "application/zip",
        "role": "Viewer"
      },
      {
        "ext": ["tar"],
        "contentTypes": ["public.tar-archive"],
        "name": "TAR Archive",
        "mimeType": "application/x-tar",
        "role": "Viewer"
      },
      {
        "ext": ["7z"],
        "contentTypes": ["org.7-zip.7-zip-archive"],
        "name": "7Z Archive",
        "mimeType": "application/x-7z-compressed",
        "role": "Viewer"
      },
      {
        "ext": ["gz"],
        "contentTypes": ["org.gnu.gnu-zip-archive"],
        "name": "GZIP Archive",
        "mimeType": "application/x-gzip",
        "role": "Viewer"
      },
      {
        "ext": ["tgz"],
        "contentTypes": ["org.gnu.gnu-zip-tar-archive"],
        "name": "TGZ Archive",
        "mimeType": "application/gzip",
        "role": "Viewer"
      }
    ]
  }
}
